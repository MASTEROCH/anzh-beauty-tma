# ANZH Beauty — переменные окружения сервера.
#
# Здесь ТОЛЬКО имена. Ни одно реальное значение не попадает ни в этот файл,
# ни в репозиторий, ни в переписку (контракт §12, §13). Токен бота приходит
# по защищённому каналу и живёт только в окружении боевого сервера.
#
# Скопировать: cp .env.example .env — и заполнить локально.

# --- База ---------------------------------------------------------------
# postgres://user:password@host:5432/dbname
DATABASE_URL=
# Пул соединений. На маленьком хостинге больше 10 обычно вредит.
DB_POOL_MAX=10
# Имя схемы (anzh) зашито в миграции намеренно и переменной не является:
# подстановка имени в каждый SQL-файл сделала бы миграции невыполнимыми
# обычным psql, а переезд в общую базу всё равно описывается отдельной
# миграцией `alter table anzh.x set schema public` (контракт §5.1).

# --- Сервер -------------------------------------------------------------
PORT=8080
HOST=0.0.0.0
# development | production
NODE_ENV=
# Откуда разрешено ходить в API. Через запятую, без завершающего слэша.
# Прод-адрес мини-приложения + адрес предпросмотра, если нужен.
CORS_ORIGINS=

# --- Telegram -----------------------------------------------------------
# Токен бота. ТОЛЬКО в окружении сервера, никогда на клиенте (§3.2, §13).
TELEGRAM_BOT_TOKEN=
# Без @. Из него сервер собирает реферальную ссылку (§4.8).
BOT_USERNAME=
# Короткое имя мини-приложения в ссылке https://t.me/<bot>/<shortname>
APP_SHORTNAME=
# Секрет вебхука. Ставится один раз вместе с вебхуком и проверяется на
# каждом входящем запросе (§3.5, §8.6). Сгенерировать:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TELEGRAM_WEBHOOK_SECRET=
# Полный публичный адрес вебхука. Вебхук ставится ОДИН раз, осознанно,
# командой — не из кода при старте (§3.5).
TELEGRAM_WEBHOOK_URL=

# --- Сессия -------------------------------------------------------------
# Ключ подписи JWT, минимум 32 байта случайных. Смена ключа разлогинивает всех.
JWT_SECRET=
# Срок жизни сессии в днях (контракт §3.3 — 7).
JWT_TTL_DAYS=7
# Максимальный возраст initData в секундах (контракт §3.2 — 1 час).
INITDATA_MAX_AGE_SEC=3600

# --- Салон --------------------------------------------------------------
# Часовой пояс салона. В базе всё в UTC; это параметр отображения и
# построения сетки слотов (§5.3).
SALON_TIMEZONE=Asia/Tbilisi
# Валюта прайса по умолчанию, ISO-4217.
SALON_CURRENCY=GEL

# --- Согласия -----------------------------------------------------------
# Версия текстов политики и оферты, на которую даётся согласие (§6.2).
# Меняется вместе с текстом — старые согласия остаются привязанными к своей.
POLICY_VERSION=

# --- Языковая модель (шаг 7, пока не используется) ----------------------
# Ключ модели — только на сервере (§10.1).
ANTHROPIC_API_KEY=
AI_MODEL=

# --- Служебное ----------------------------------------------------------
# Общий секрет для вызова /api/v1/tasks/run внешним планировщиком (§9).
CRON_SECRET=
