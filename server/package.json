{
  "name": "anzh-beauty-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "node --env-file=.env --watch src/index.ts",
    "start": "node src/index.ts",
    "migrate": "node --env-file=.env scripts/migrate.ts",
    "migrate:status": "node --env-file=.env scripts/migrate.ts --status",
    "seed": "node --env-file=.env scripts/seed.ts",
    "export": "node --env-file=.env scripts/export.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.ts"
  },
  "dependencies": {
    "fastify": "^5.2.0",
    "postgres": "^3.4.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@electric-sql/pglite-socket": "^0.2.11",
    "@types/node": "^22.10.5",
    "typescript": "^5.7.2",
    "yaml": "^2.9.1"
  }
}
