{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build:demo",
  "outputDirectory": "dist",
  "framework": "vite",
  "functions": {
    "api/v1/[...path].mjs": {
      "maxDuration": 60,
      "includeFiles": "tools/{dev-stand.mjs,stand-seed.json}"
    }
  },
  "rewrites": [
    { "source": "/photos/uploads/:name", "destination": "/api/v1/uploads-file/:name" },
    { "source": "/((?!api/|assets/|photos/|brand/|legal/|fonts/|favicon|mascot/).*)", "destination": "/index.html" }
  ],
  "headers": [
    { "source": "/assets/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] },
    { "source": "/photos/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=3600, s-maxage=86400, stale-while-revalidate=604800" }] }
  ]
}
